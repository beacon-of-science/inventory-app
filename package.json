{
  "name": "inventory-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "简库存：离线 Android 商品与药品库存管理",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && node scripts/build-android.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "vant": "^4.9.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0"
  }
}
